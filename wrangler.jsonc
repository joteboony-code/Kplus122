{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kplus122-webhook",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "services": [
    {
      "binding": "CASTLE_SERVICE",
      "service": "serviceeast",
      "entrypoint": "ServiceLookup"
    }
  ],
  "d1_databases": [
    {
      "binding": "CONTROL_DB",
      "database_name": "kplus122-control",
      "database_id": "b10b2051-82ec-451d-993d-cb6035f6a24b"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RECEIPT_ROUNDS",
        "class_name": "ReceiptRoundCoordinator"
      },
      {
        "name": "OPERATIONAL_COUNTERS",
        "class_name": "OperationalCounterCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ReceiptRoundCoordinator"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["OperationalCounterCoordinator"]
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "queues": {
    "producers": [
      {
        "binding": "LINE_WEBHOOKS",
        "queue": "kplus122-line-webhooks"
      },
      {
        "binding": "IMAGE_QUEUE",
        "queue": "kplus122-images"
      },
      {
        "binding": "OCR_FALLBACK_QUEUE",
        "queue": "kplus122-ocr-fallback"
      }
    ],
    "consumers": [
      {
        "queue": "kplus122-line-webhooks",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "max_concurrency": 5
      },
      {
        "queue": "kplus122-images",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 1,
        "max_concurrency": 10
      },
      {
        "queue": "kplus122-ocr-fallback",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 1,
        "max_concurrency": 2
      }
    ]
  },
  "vars": {
    "EXPECTED_SALE_AMOUNT": "1.22",
    "EXPECTED_VOID_AMOUNT": "-1.22",
    "MIN_CONFIDENCE": "0.65",
    "PADDLEOCR_MODEL": "PaddleOCR-VL-1.6",
    "PROCESSING_FORCE_DISABLED": "false"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
