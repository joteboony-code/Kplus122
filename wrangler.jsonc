{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kplus122-webhook",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "kv_namespaces": [
    {
      "binding": "REPLY_STATE",
      "id": "b9273896beec42ccb2f75a1286f4c037"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "IMAGE_QUEUE",
        "queue": "kplus122-images"
      }
    ],
    "consumers": [
      {
        "queue": "kplus122-images",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "max_concurrency": 1
      }
    ]
  },
  "vars": {
    "EXPECTED_SALE_AMOUNT": "1.22",
    "EXPECTED_VOID_AMOUNT": "-1.22",
    "MIN_CONFIDENCE": "0.65",
    "ENABLE_PUSH_FALLBACK": "false"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
